# l00prite CLI-OS environment. Copy to .env and adjust, or export directly. All optional —
# sensible, safe-by-default values are used when unset.

# Where keys (encrypted), the SQLite db, and the ledger live.
# LOOPRITE_HOME=/var/lib/l00prite-cli-os

# Bind address + port. Default host is 127.0.0.1 (loopback only).
# LOOPRITE_HOST=127.0.0.1
# LOOPRITE_PORT=8787

# Default per-project daily spend cap (USD) when a project has no explicit cap.
# LOOPRITE_DEFAULT_DAILY_CAP=10

# Master key for the provider-key vault (base64 of 32 bytes). If unset, a keyfile is
# auto-generated at $LOOPRITE_HOME/master.key (chmod 600). Pin it here to keep it off disk.
# Generate:  openssl rand -base64 32     (or: head -c 32 /dev/urandom | base64)
# LOOPRITE_MASTER_KEY=

# Public TLS (required to bind a non-loopback host). Point these at your cert + key.
# LOOPRITE_TLS_CERT=/etc/l00prite/tls/cert.pem
# LOOPRITE_TLS_KEY=/etc/l00prite/tls/key.pem

# Only if you deliberately bind a non-loopback host WITHOUT TLS (e.g. behind a trusted reverse
# proxy on a private network). Leave unset for the safe default.
# LOOPRITE_ALLOW_INSECURE_BIND=1

<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background: LOOPRITE's dark circuit board.

  Static-color vector only — no <gradient>/aapt:attr inline resources, which the
  aapt-v1 hermetic build pipeline (cli-os/scripts/build-apk.sh) cannot compile.
  "Glow" is faked with layered low-alpha strokes instead. The circuit traces sit
  near the 108dp canvas corners: visible under square-ish adaptive masks, cleanly
  cropped by circular ones, and always outside the 66dp safe zone the foreground
  owns.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- base: deep navy, matched to the site background -->
    <path
        android:pathData="M0,0 H108 V108 H0 Z"
        android:fillColor="#050B13" />

    <!-- diagonal tone split for subtle depth (no gradients available) -->
    <path
        android:pathData="M0,0 L108,0 L0,108 Z"
        android:fillColor="#081221" />

    <!-- faint circuit traces, top-left corner -->
    <path
        android:pathData="M14,22 H32 L42,32"
        android:strokeColor="#1F3FB6E8"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M22,12 V26 L30,34"
        android:strokeColor="#173FB6E8"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- faint circuit traces, bottom-right corner -->
    <path
        android:pathData="M94,86 H76 L66,76"
        android:strokeColor="#1F3FB6E8"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M86,96 V82 L78,74"
        android:strokeColor="#173FB6E8"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- solder-pad nodes at the trace heads -->
    <path
        android:pathData="M14,22 m-2.2,0 a2.2,2.2 0 1,1 4.4,0 a2.2,2.2 0 1,1 -4.4,0"
        android:fillColor="#333FB6E8" />
    <path
        android:pathData="M22,12 m-1.7,0 a1.7,1.7 0 1,1 3.4,0 a1.7,1.7 0 1,1 -3.4,0"
        android:fillColor="#2A3FB6E8" />
    <path
        android:pathData="M94,86 m-2.2,0 a2.2,2.2 0 1,1 4.4,0 a2.2,2.2 0 1,1 -4.4,0"
        android:fillColor="#333FB6E8" />
    <path
        android:pathData="M86,96 m-1.7,0 a1.7,1.7 0 1,1 3.4,0 a1.7,1.7 0 1,1 -3.4,0"
        android:fillColor="#2A3FB6E8" />

    <!-- whisper-faint halo ring behind the foreground loop -->
    <path
        android:pathData="M54,54 m-30,0 a30,30 0 1,1 60,0 a30,30 0 1,1 -60,0"
        android:strokeColor="#0A3FB6E8"
        android:strokeWidth="10" />
</vector>
